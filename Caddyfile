{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Logging
	log {
		output stdout
		format console
	}

	# SSE unbuffered stream proxy
	@sse path /api/v1/events/stream
	handle @sse {
		reverse_proxy api:8080 {
			flush_interval -1
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# API routing to Go Modular Monolith
	handle /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ML Inference service routing
	handle /ml/* {
		uri strip_prefix /ml
		reverse_proxy ml:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Frontend Vite React PWA routing (with proxy to web container)
	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
