# ==========================================
# General & Environment
# ==========================================
ENVIRONMENT=development
TZ=Asia/Colombo

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waypoint_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waypoint_db?sslmode=disable

# ==========================================
# Go Modular Monolith API (apps/api)
# ==========================================
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET=super-secret-jwt-key-change-in-production-32chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
ML_SERVICE_URL=http://localhost:8000

# ==========================================
# ML Inference Service (apps/ml)
# ==========================================
ML_PORT=8000
ML_HOST=0.0.0.0
MODEL_ENV=development
LOG_LEVEL=info

# ==========================================
# Web PWA Frontend (apps/web)
# ==========================================
PORT=3000
VITE_API_URL=http://localhost:8080/api/v1
VITE_ML_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Waypoint Operations PWA"
VITE_DEFAULT_TIMEZONE=Asia/Colombo
VITE_DEFAULT_LOCALE=en

# ==========================================
# Caddy Reverse Proxy
# ==========================================
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
DOMAIN=localhost

# ==========================================
# Judge walkthrough
# ==========================================
# Password for the seeded role accounts (dispatcher/loader/driver/store). Loader PIN: 1234
BOOTSTRAP_PASSWORD=WaypointJudge2026!
# Business clock start. Must fall inside the official calendar (2024-01-01..2026-06-28).
# 15:00 the day before 2026-06-22 leaves one hour before the 16:00 order cutoff.
BUSINESS_NOW=2026-06-21T15:00:00+05:30
# Cap stops per trip so the judge walkthrough stays short (0 = no cap). Not a booklet rule.
PLAN_MAX_STOPS_PER_TRIP=3
